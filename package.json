{
  "name": "my-interview-question",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm -w web run dev",
    "dev:server": "node server/index.js",
    "dev:https": "HTTPS=1 node server/index.js",
    "cert:gen": "node scripts/gen-cert.mjs",
    "icon:gen": "node scripts/gen-icons.mjs",
    "build": "npm -w web run build",
    "start": "node server/index.js",
    "test": "npm -w web run test",
    "test:server": "node --test server/",
    "typecheck": "npm -w web run typecheck",
    "test:e2e": "playwright test",
    "start:test": "NODE_ENV=test node server/index.js",
    "pdf:extract": "node scripts/extract-questions.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:progress": "node scripts/smoke-progress.mjs",
    "smoke:backup": "node scripts/smoke-backup.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-edge-tts": "^1.2.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
