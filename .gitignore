.DS_Store
node_modules/
dist/
build/
*.log
.env
.env.local

# 运行期数据（SQLite 文件不进仓库）
data/
*.db

# PDF 题库原件：33MB，不进仓库
# ⚠️ 必须写成 /pdf/（带前导斜杠）：不带斜杠的 pdf/ 会匹配**任意层级**的同名目录，
#    把 web/src/lib/pdf/（PDF 切题算法 + 单测）一起忽略掉 —— 那份代码曾因此从未进过版本库。
/pdf/

# 解析与测试的中间产物
tmp/
test-results/
playwright-report/

# 本机 HTTPS 自签证书（私钥绝不进仓库）
certs/

# 演示录制：中间产物与成品（webm / mp4 / gif / 片头卡片）、演示库、免登录状态
# 素材（demo/assets/ 下的 PDF 与音频）要进仓库，重录时直接用
demo/output/
demo/.db/
demo/.auth/
